# ── 1. Setup ────────────────────────────────────────────────────────────────

include /etc/sway/config.d/*

set $mod Mod4
set $term kitty
set $qs exec qs ipc call

# Catppuccin Mocha
set $lavender #b4befe
set $mantle   #181825
set $base     #1e1e2e
set $text     #cdd6f4
set $red      #f38ba8


# ── 2. Hardware ─────────────────────────────────────────────────────────────

output DP-3 {
    mode 2560x1440@120Hz
    position 0 0
    scale 1
}

input type:keyboard {
    xkb_layout us
    # Caps does nothing by itself; it's bound to the shell's compose panel
    xkb_options caps:none
    repeat_delay 300
    repeat_rate 25
}

input type:pointer {
    # Raw 1:1 movement, no acceleration
    accel_profile flat
    pointer_accel 0
}

seat seat0 {
    xcursor_theme Adwaita 24
    hide_cursor when-typing enable
}


# ── 3. Look ─────────────────────────────────────────────────────────────────

gaps inner 8
gaps outer 4
default_border pixel 2
default_floating_border pixel 2
hide_edge_borders none
# A window alone on a workspace gets no gaps or border
smart_gaps on
smart_borders on

# Tab titles (tabbed containers), in the shell's font
font pango:JetBrainsMono Nerd Font 10
titlebar_padding 6 2

#                       border     background text   indicator  child_border
client.focused          $lavender  $base      $text  $lavender  $lavender
client.focused_inactive $mantle    $base      $text  $mantle    $mantle
client.unfocused        $mantle    $base      $text  $mantle    $mantle
client.urgent           $red       $base      $text  $red       $red


# ── 4. Behaviour ────────────────────────────────────────────────────────────

focus_follows_mouse yes
# Keyboard focus moves the pointer to the window, so it doesn't pull focus back
mouse_warping container
# Apps asking for focus (a link opening in Zen) get it, not just an urgent hint
focus_on_window_activation focus
# Only the fullscreen app's own dialogs show over it
popup_during_fullscreen smart

# Window rules
# Don't focus empty-class/title XWayland popups
no_focus [shell="xwayland" class="^$" title="^$"]
# Fullscreen windows (videos, games) hold off the shell's idle lock and
# screen-off
for_window [all] inhibit_idle fullscreen


# ── 5. Startup ──────────────────────────────────────────────────────────────

exec dbus-update-activation-environment --systemd --all
exec dbus-update-activation-environment --systemd GTK_USE_PORTAL=1

# Clipboard history for the shell's clipboard panel
exec wl-paste --type text --watch cliphist store
exec wl-paste --type image --watch cliphist store

# Run the shell (`-n` to load duplicates when resetting sway) 
exec_always qs -n

# Dwindle behaviour
exec_always swaymsg -m -t subscribe '["window"]' | jq --unbuffered -r 'select(.change=="focus" or .change=="new") | .container | select(.type=="con" and .fullscreen_mode==0) | if .rect.width > .rect.height then "splith" else "splitv" end' | while read -r d; do swaymsg "$d" >/dev/null; done

# ── 6. Keys ─────────────────────────────────────────────────────────────────

# Shell panels
bindsym $mod+space  $qs launcher toggle
bindsym $mod+v      $qs clipboard toggle
bindsym $mod+c      $qs control toggle
bindsym $mod+Escape $qs session toggle
bindsym $mod+l      $qs session lock
bindsym $mod+F1     $qs keys toggle
# Caps Lock (keycode 66)
bindcode 66         $qs compose toggle

# Capture
bindsym Print       $qs capture screenshot
bindsym Shift+Print $qs capture record
bindsym Ctrl+Print  $qs capture voice
bindsym $mod+Print  $qs capture stop

# Media keys (--locked: they work on the lock screen too)
bindsym --locked XF86AudioRaiseVolume $qs audio up
bindsym --locked XF86AudioLowerVolume $qs audio down
bindsym --locked XF86AudioMute        $qs audio mute
bindsym --locked XF86AudioPlay        $qs media toggle
bindsym --locked XF86AudioNext        $qs media next
bindsym --locked XF86AudioPrev        $qs media previous

# Apps
bindsym $mod+Return       exec $term
bindsym $mod+b            exec zen-browser
bindsym $mod+y            exec $term -e yazi ~/Downloads/
bindsym $mod+Shift+Escape exec $term -e btop

# Windows
bindsym $mod+q kill
bindsym $mod+f fullscreen toggle
bindsym $mod+t floating toggle
# Switch focus between the floating and the tiled windows
bindsym $mod+Shift+t focus mode_toggle
# Super + left-drag moves, Super + right-drag resizes
floating_modifier $mod normal

# Focus
bindsym $mod+Up    focus up
bindsym $mod+Down  focus down
bindsym $mod+Left  focus left
bindsym $mod+Right focus right

# Move the focused window 
bindsym $mod+Shift+Up    move up
bindsym $mod+Shift+Down  move down
bindsym $mod+Shift+Left  move left
bindsym $mod+Shift+Right move right

# Resize: Right/Down grow, Left/Up shrink
bindsym $mod+Ctrl+Right resize grow width 40px
bindsym $mod+Ctrl+Left  resize shrink width 40px
bindsym $mod+Ctrl+Down  resize grow height 40px
bindsym $mod+Ctrl+Up    resize shrink height 40px

# Layout
# Where the next window opens: beside (|) or below (-) the focused one
bindsym $mod+backslash splith
bindsym $mod+minus     splitv
# The container the focused window is in: flip side-by-side <-> stacked,
# or turn tabs on/off
bindsym $mod+e layout toggle split
bindsym $mod+g layout toggle tabbed split

# Workspaces: Super+N goes there, Super+Shift+N takes the window along
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+Shift+1 move container to workspace number 1; workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2; workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3; workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4; workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5; workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6; workspace number 6
# Back to the previous workspace
bindsym $mod+Tab workspace back_and_forth

# Sway itself
bindsym $mod+Shift+c reload
bindsym $mod+Shift+e exec swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit sway? This will end your Wayland session.' -B 'Yes, exit sway' 'swaymsg exit'
